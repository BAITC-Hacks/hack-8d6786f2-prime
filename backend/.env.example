# Copy to backend/.env for source development. Never commit real keys.
LLM_PROVIDER=openai
# Replace the placeholder with your own key, or leave it unchanged for offline fallback.
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=
LLM_TIMEOUT_SECONDS=6
LLM_MAX_CONCURRENCY=4
LLM_CALLS_PER_MINUTE=30
LLM_CALLS_PER_SESSION=500
