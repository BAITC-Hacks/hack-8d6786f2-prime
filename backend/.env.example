# Copy to backend/.env. Do not commit real keys.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=
LLM_TIMEOUT_SECONDS=6
# SQL database file; relative paths resolve from the project root (bundle: local data folder).
# DATABASE_PATH=data/catalog.sqlite3
# Generate a random token with at least 32 characters; keep only in backend/.env.
ADMIN_API_TOKEN=
# Optional absolute path; default is data/contractors.csv in this repository.
# CONTRACTORS_CSV=
# Optional: built public frontend directory. Defaults to frontend/dist.
# SAT_FRONTEND_DIR=
# SAT_DATA_DIR is set before launch to choose a separate .env and SQL state directory.
